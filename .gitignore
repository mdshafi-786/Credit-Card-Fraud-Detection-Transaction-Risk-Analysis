# ═══════════════════════════════════════════════════════════════
# .gitignore — Credit Card Fraud Detection & Risk Analysis
# ═══════════════════════════════════════════════════════════════

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.manifest
*.spec

# ─── Virtual Environments ───────────────────────────────────
venv/
env/
.env/
.venv/
ENV/

# ─── IDE & Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS Files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Jupyter Notebooks ─────────────────────────────────────
.ipynb_checkpoints/

# ─── Database (auto-generated, re-seeded on launch) ────────
fraud_detection.db

# ─── Trained Model Artifacts (re-generated via training) ───
backend/ml/fraud_model.pkl
backend/ml/scaler.pkl
backend/ml/label_encoders.pkl
backend/ml/feature_names.pkl
backend/ml/model_metrics.json
backend/ml/feature_importance.json

# ─── Streamlit ──────────────────────────────────────────────
.streamlit/secrets.toml

# ─── Environment Variables ──────────────────────────────────
.env
.env.local
.env.production

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/

# ─── Distribution / Packaging ──────────────────────────────
*.tar.gz
*.whl
